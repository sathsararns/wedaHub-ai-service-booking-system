# Copy to .env and set your own API key.
GROQ_API_KEY=
MODEL_NAME=llama-3.1-8b-instant

# Express backend: provider search uses EXPRESS_API; bookings use BACKEND_URL.
BACKEND_URL=http://localhost:3000
EXPRESS_API=http://localhost:3000/api

LOG_LEVEL=INFO
# Set false on Render Free to use keyword search without loading local embeddings.
RAG_ENABLED=true
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=wedahub-ai-service
# Optional, only needed when enabling LangSmith:
# LANGCHAIN_API_KEY=

# Optional, only used by experiments/legacy/database.py:
# MONGO_URI=
# DB_NAME=
